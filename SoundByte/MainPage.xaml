<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:SoundByte.Converters"
             xmlns:models="clr-namespace:SoundByte.Models"
             xmlns:viewmodels="clr-namespace:SoundByte.ViewModels"
             x:Class="SoundByte.MainPage"
             x:DataType="viewmodels:SoundByteViewModel">
	<ContentPage.Resources>
		<converters:SoundByteColorConverter x:Key="ColorConverter"/>
	</ContentPage.Resources>
	<VerticalStackLayout Padding="30,0"
                         Spacing="25">
		<HorizontalStackLayout>
			<Picker x:Name="DisplayGroupPicker"
					Title="Select a Group"
					ItemsSource="{Binding Groups}"
					SelectedItem="{Binding SelectedGroup}"
					ItemDisplayBinding="{Binding Name}"/>
		</HorizontalStackLayout>
		<CollectionView ItemsSource="{Binding SelectedGroup.Items}">
			<CollectionView.ItemsLayout>
				<GridItemsLayout Orientation="Vertical"
								 Span="2"
								 HorizontalItemSpacing="10"
								 VerticalItemSpacing="10"/>
			</CollectionView.ItemsLayout>
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="viewmodels:SoundbyteItemViewModel">
					<HorizontalStackLayout Padding="10,5"
											   Spacing="10">
						<BoxView Color="{Binding Color, Converter={StaticResource ColorConverter}}"
                                     WidthRequest="8"
                                     HeightRequest="16"
                                     VerticalOptions="Center"
                                     CornerRadius="8"/>
						<Label Text="{Binding Name}"
                                   VerticalOptions="Center"/>
					</HorizontalStackLayout>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<Entry x:Name="AddSoundbyteNameEntry"
               Placeholder="Enter sound byte name"/>
		<Button Text="Choose File"
				Clicked="ChooseFile"/>
		<Entry x:Name="AddSoundbyteFilePathEntry"
               IsReadOnly="True"/>
		<Picker x:Name="AddSoundbyteColorPicker"
                Title="Select a Color"/>
		<Button Text="Add SoundByte"
                Clicked="OnAddSoundbyteClicked"
                HorizontalOptions="Fill"/>
	</VerticalStackLayout>
</ContentPage>