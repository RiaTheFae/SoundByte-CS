<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:viewmodels="clr-namespace:SoundByte.ViewModels"
             x:Class="SoundByte.Views.OptionsPage"
             Title="OptionsPage"
			 x:DataType="viewmodels:SoundbyteOptionsViewModel">
	<Grid RowDefinitions="50,50,50,50">
		<Label Text="Max Width of Soundbytes: "/>
		<Entry x:Name="MaxWidthOption"
			   Keyboard="Numeric"
			   Text="{Binding MaxWidth}"
			   MaximumHeightRequest="50"/>
		<Label Text="{Binding MaxWidth}"
			   Grid.Row="3"/>
	</Grid>
</ContentPage>